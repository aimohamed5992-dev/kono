# /etc/kono/kono-api.env — loaded by systemd. Keep it chmod 600, owned by root.

# MariaDB / MySQL (create the DB + user first, see README-DEPLOY.md)
ConnectionStrings__Default=Server=127.0.0.1;Port=3306;Database=kono;User=kono;Password=CHANGE_ME;TreatTinyAsBoolean=true;AllowUserVariables=true;UseAffectedRows=false

# JWT signing key — 32+ random chars. install.sh generates one on first install.
Jwt__Key=CHANGE_ME_RANDOM_64_CHARS
Jwt__Issuer=kono-api
Jwt__Audience=kono-clients

# The public https URL of the API: image / upload URLs returned to the apps are built from it.
App__PublicBaseUrl=https://api.example.com

# Origins allowed to call the API from a browser (admin dashboard, merchant portal). One per index.
Cors__AllowedOrigins__0=https://admin.example.com
Cors__AllowedOrigins__1=https://portal.example.com
